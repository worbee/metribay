# Copy to docker/.env. Keep the real file private and back up APP_KEY separately from the data volume.

# Required. Create with: docker run --rm ghcr.io/worbee/metribay key
APP_KEY=
# The address you open Metribay at. Used in emails and generated links.
APP_URL=http://localhost:8080

# Behind an HTTPS reverse proxy: trust it and send secure cookies.
# METRIBAY_TRUSTED_PROXIES=172.16.0.0/12
# SESSION_SECURE_COOKIE=true

# Optional usage statistics are only sent after the user agrees. Set false to remove the prompt.
# METRIBAY_ANALYTICS_ENABLED=false

# Your own Google OAuth app (docs/PROVIDERS.md). Service accounts work without it.
# METRIBAY_GOOGLE_CLIENT_ID=
# METRIBAY_GOOGLE_CLIENT_SECRET=
# METRIBAY_GOOGLE_REDIRECT_URI=https://metrics.example.com/integrations/google/callback

# Password reset emails. Without mail, use php artisan metribay:install again on a new installation.
# MAIL_MAILER=smtp
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=metribay@example.com

# Only with compose.postgres.yaml
# POSTGRES_PASSWORD=
